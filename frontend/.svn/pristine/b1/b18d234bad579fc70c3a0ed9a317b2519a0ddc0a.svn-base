<style type="text/css">.login-banner {
   object-fit: cover;
   object-position: center;
}

.auth-pass-inputgroup input[type=text]+.btn .ri-eye-fill:before {
   content: "\ec80"
}

.iq-error {
   height: auto !important;
}


/* 
   INFO BOX
   ==========================================================
 */

.info-box {
   box-shadow: 0 0 1px rgba(0, 0, 0, .125), 0 1px 3px rgba(0, 0, 0, .2);
   border-radius: .25rem;
   background-color: #fff;
   display: -webkit-flex;
   display: -ms-flexbox;
   display: flex;
   margin-bottom: 1rem;
   min-height: 80px;
   padding: .5rem;
   position: relative;
   width: 100%;
}

.info-box .info-box-icon {
   border-radius: .25rem;
   -webkit-align-items: center;
   -ms-flex-align: center;
   align-items: center;
   display: -webkit-flex;
   display: -ms-flexbox;
   display: flex;
   font-size: 1.875rem;
   -webkit-justify-content: center;
   -ms-flex-pack: center;
   justify-content: center;
   text-align: center;
   width: 70px;
}

.info-box .info-box-content {
   display: -webkit-flex;
   display: -ms-flexbox;
   display: flex;
   -webkit-flex-direction: column;
   -ms-flex-direction: column;
   flex-direction: column;
   -webkit-justify-content: center;
   -ms-flex-pack: center;
   justify-content: center;
   line-height: 1.8;
   -webkit-flex: 1;
   -ms-flex: 1;
   flex: 1;
   padding: 0 10px;
}

.info-box .info-box-text, .info-box .progress-description {
   display: block;
   overflow: hidden;
   text-overflow: ellipsis;
   white-space: nowrap;
}

.info-box .info-box-number {
   display: block;
   margin-top: .25rem;
   font-weight: 700;
}

/*
   TABS
*/

.dark .nav-tabs .nav-item.show .nav-link,
.dark .nav-tabs .nav-link.active {
   border: none !important;
}

.dark .nav-tabs .nav-item.show .nav-link,
.dark .nav-tabs .nav-link.active {
   border-bottom: 2px solid #0084ff !important;
   color: #0084ff !important;
}

.dark .nav-tabs .nav-item.show .nav-link,
.dark .nav-tabs .nav-link.active {
   background: #2d325a !important;
}

.dark .nav-tabs a:hover {
   border: 1px solid #2d325a !important;
}

@media (max-width: 991px) {
   .dark .navbar-collapse {
      background-color: #25294a !important;
      border-top: 1px solid #2d325a;
      border-bottom: 1px solid #2d325a;
      /* #2d325a !important; */
   }
}</style><style type="text/css">.component-input-uppercase {
   text-transform: uppercase !important;
}

.component-input-uppercase::placeholder {
   text-transform: none !important;
}

.component-input-lowercase {
   text-transform: lowercase !important;
}

.component-input-lowercase:placeholder {
   text-transform: none !important;
}

/* 
   SELECT
   ==========================================================
 */

/* .is-invalid .select__control {
   border: 1px solid #dc3545 !important;
} */

.dark .is-invalid .select__control {
   border: unset !important;
}

.select__control {
   background: #e9edf4 !important;
   border: 0px solid #d7dbda !important;
   font-size: 14px;
   color: #8c91b6 !important;
   border-radius: .25rem !important;
   padding: 0px 2px;
   line-height: 33px;
}


.dark .select__control {
   background: #25294a !important;
   border: unset !important;
   color: #8c91b6 !important;
   border: 1px solid #333 !important;
}

.select__control--is-disabled {
   background-color: #e9ecef !important;
   opacity: 1 !important;
}

.dark .select__control--is-disabled {
   background-color: #e9ecef !important;
   border-color: #262626 !important;
   color: #8c91b6 !important;
}

.select__control--is-focused {
   box-shadow: 0 0 0 0px #0084ff !important;
}

.select__single-value--is-disabled {
   color: #495057 !important;
}


.dark .select__single-value--is-disabled {
   color: #8f9198 !important;
}

.dark .select__single-value,
.dark .select__placeholder {
   color: #8c91b6 !important;
}

.select__control--menu-is-open {
   box-shadow: 0 0 0 0px #0084ff !important;
}

.select__option:hover {
   background: #0084ff !important;
   color: #fff !important;
}

.select__option--is-selected {
   /* background: var(--bs-secondary) !important; */
   background: #0084ff !important;
   opacity: .8;
}

.select__option--is-selected:hover {
   /* background: var(--bs-secondary) !important; */
   background: #0084ff !important;
   opacity: .8;
}


.select__option--is-focused {
   background: #0084ff !important;
   color: #fff !important;
}


body[data-layout-mode=dark] .select__indicator-separator {
   color: #8f9198 !important;
}

.dark .select__menu {
   background: #25294a !important;

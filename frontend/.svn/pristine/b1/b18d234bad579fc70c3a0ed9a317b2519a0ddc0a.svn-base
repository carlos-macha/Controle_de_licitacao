/*# sourceMappingURL=tabulator_simple.min.css.map */</style><style type="text/css">.tabulator-row.tabulator-selected,
.tabulator-row.tabulator-selected i,
.tabulator-row.tabulator-selected:hover {
   background-color: #0084ff !important;
   color: #fff;
}

.dark .tabulator-row.tabulator-selected i {
   background-color: #25294a !important;
}

.tabulator-row:hover {
   background-color: #e5f2ff !important;
}

.tabulator .tabulator-footer {
   background-color: transparent !important;
}

.tabulator .tabulator-header {
   background-color: var(--iq-light-border) !important;
}


/* .tabulator .tabulator-header .tabulator-col {
   background-color: var(--iq-light-border) !important;
} */


.tabulator .tabulator-header .tabulator-col.tabulator-sortable.tabulator-col-sorter-element:hover {
   cursor: pointer;
   background-color: #e6e6e6 !important;
}

.dark .tabulator .tabulator-header .tabulator-col.tabulator-sortable.tabulator-col-sorter-element:hover {
   cursor: pointer;
   background-color: #25294a !important;
}

/*
  dark
*/

.dark .tabulator-row.tabulator-selected,
.dark .tabulator-row.tabulator-selectable:hover {
   background-color: #25294a !important;
}

/* 
.dark .tabulator-row.tabulator-selectable:hover {
   background-color: #343a40 !important;
} */

.dark .tabulator {
   background-color: var(--iq-dark-body-bg) !important;

   /* background-color: #25294a !important; */
}

.dark .tabulator .tabulator-footer {
   background-color: var(--iq-dark-body-bg) !important;
}

.dark .tabulator .tabulator-header {
   background-color: var(--iq-dark-hover-bg) !important;
   border-bottom: 2px solid #25294a;
}

.dark .tabulator .tabulator-frozen-rows-holder {
   background-color: var(--iq-dark-hover-bg) !important;
}

.dark .tabulator .tabulator-tableholder .tabulator-table {
   background-color: var(--iq-dark-body-bg) !important;
}

.dark .tabulator-row {
   background-color: var(--iq-dark-body-bg) !important;
   color: #FFF !important;
   border-bottom: 1px solid #25294a !important;
}

.dark .tabulator-row:hover {
   background-color: #25294a !important;
}

.dark .tabulator .tabulator-header {
   color: #fff !important;
}

.dark .tabulator-frozen {
   background-color: #2d325a !important;
}

.dark .tabulator .tabulator-header .tabulator-col {
   background-color: #2d325a !important;
}

.dark .tabulator .tabulator-header .tabulator-col .tabulator-header-filter input:focus {
   background-color: #2d325a !important;
}

.dark .tabulator-row.tabulator-row-even {
   /* background-color: #222033 !important; */
   /* background-color: rgb(63, 52, 78) !important; */
}


.dark .tabulator .tabulator-header .tabulator-col.tabulator-sortable.tabulator-col-sorter-element:hover {
   cursor: pointer;
   /* background-color: #343a40 !important; */
   color: #FFF;
}

.dark .tabulator .tabulator-header .tabulator-col,
.dark .tabulator-row .tabulator-cell,
.dark .tabulator-row .tabulator-cell.tabulator-frozen.tabulator-frozen-left,
.dark .tabulator .tabulator-header .tabulator-frozen.tabulator-frozen-right,
.dark .tabulator-row .tabulator-cell.tabulator-frozen.tabulator-frozen-right,
.dark .tabulator .tabulator-header .tabulator-frozen.tabulator-frozen-left,
.dark .tabulator-row .tabulator-cell.tabulator-frozen.tabulator-frozen-left {
   border-right: 2px solid #25294a !important;
}

.dark .tabulator-row .tabulator-cell {
   border-bottom: 1px solid #25294a !important;
}

/*#343a40*/</style><style type="text/css">.btn-options-dropdown,
.btn-options-dropdown>button {
   font-size: x-large;
   padding-top: 2px;
   padding-left: 0;
   padding-right: 0;
   padding-bottom: 0;
}

.dark .btn-options-dropdown>button {
   color: #fff;
}

.btn-options-dropdown>button::after {
   display: none;
}</style><style type="text/css">/* .view-crud-pesquisa-visibilidade .card-body {
   padding-top: 0 !important;
}

.view-crud-pesquisa-visibilidade .card-body>div {
   margin-bottom: 6px !important;
} */</style><style type="text/css"></style><style id="smooth-scrollbar-style">
[data-scrollbar] {
  display: block;
  position: relative;
}

.scroll-content {
  display: flow-root;
  -webkit-transform: translate3d(0, 0, 0);
          transform: translate3d(0, 0, 0);
}

.scrollbar-track {
  position: absolute;
  opacity: 0;
  z-index: 1;
  background: rgba(222, 222, 222, .75);
  -webkit-user-select: none;
     -moz-user-select: none;
      -ms-user-select: none;
          user-select: none;
  -webkit-transition: opacity 0.5s 0.5s ease-out;
          transition: opacity 0.5s 0.5s ease-out;
}
.scrollbar-track.show,
.scrollbar-track:hover {
  opacity: 1;
  -webkit-transition-delay: 0s;
          transition-delay: 0s;
}

.scrollbar-track-x {
  bottom: 0;
  left: 0;
  width: 100%;
  height: 8px;
}
.scrollbar-track-y {
  top: 0;
  right: 0;
  width: 8px;
  height: 100%;
}
.scrollbar-thumb {
  position: absolute;
  top: 0;
  left: 0;
  width: 8px;
  height: 8px;
  background: rgba(0, 0, 0, .5);

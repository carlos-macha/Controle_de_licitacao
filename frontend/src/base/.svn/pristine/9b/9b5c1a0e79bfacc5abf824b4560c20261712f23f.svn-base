body.sidebar-main .iq-sidebar:hover .iq-sidebar-menu .iq-menu li a div {
   opacity: 1;
   display: inline-block;
}

body.sidebar-main .iq-sidebar .iq-sidebar-menu .iq-menu li a div {
   opacity: 0;
   display: none;
}

@media (max-width: 1299px) {
   body.sidebar-main .iq-sidebar .iq-sidebar-menu .iq-menu li a div {
      display: inline-block;
      opacity: 1;
   }
}


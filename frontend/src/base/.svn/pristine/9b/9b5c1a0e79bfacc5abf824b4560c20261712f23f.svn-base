.custom-footer-sidebar {
   bottom: 0;
   left: 0;
   position: fixed;
   right: 0;
   z-index: -1000;
   width: 250px !important;
}

.scrollbar-logo-bottom {
   height: calc(100vh - 8rem) !important;
}

body.sidebar-main .iq-sidebar .custom-footer-sidebar .logo-bottom {
   opacity: 0 !important;
   display: none !important;
}

body.sidebar-main .iq-sidebar:hover .custom-footer-sidebar .logo-bottom {
   opacity: 1 !important;
   display: inline-block !important;
}

@media (max-width: 1299px) {
   body.sidebar-main .iq-sidebar .custom-footer-sidebar .logo-bottom {
      opacity: 1 !important;
      display: inline-block !important;
   }

   .custom-footer-sidebar {
      opacity: 0 !important;
      display: none !important;
   }

   body.sidebar-main .iq-sidebar .custom-footer-sidebar {
      opacity: 1 !important;
      display: inline-block !important;
   }



   /*body.custom-footer-sidebar {
      opacity: 1 !important;
      display: inline-block !important;
   } */

}
.datasearch-containner {
   display: -webkit-flex;
   display: -ms-flexbox;
   display: flex;
   -webkit-flex-wrap: wrap;
   -ms-flex-wrap: wrap;
   flex-wrap: wrap;
}

.datasearch-containner>div>div>div,
.datasearch-containner>div>button,
.datasearch-containner>div>input {
   margin-right: 4px !important;
   margin-bottom: 2px !important;
   margin-top: 2px !important;
}

.datasearch-containner>div>button.btn-checkbox {
   margin-right: 0px !important;
}
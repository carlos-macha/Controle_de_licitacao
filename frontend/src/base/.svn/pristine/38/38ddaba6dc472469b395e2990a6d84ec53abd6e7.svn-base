import DAO from "./dao";
import { IModelCrm031 } from "../models/modelCRM031";
import { IModelMOB012 } from "../models/modelMOB012";
import { utilities } from "../utils/utilities";
import { IModelUsuario } from "../models/modelUsuario";
import { IModelCrm009 } from "../models/modelCRM009";
import { IModelMOB001 } from "../models/modelMOB001";
import { IModelCrm038 } from "../models/modelCRM038";
import { IModelCrm037 } from "../models/modelCRM037";
import { IModelAux030 } from "../models/modelAUX030";
import { IModelEst001 } from "../models/modelEST001";
import { IModelKanban } from "../models/modelKanban";
import { IModelAux039 } from "../models/modelAUX039";
import { IModelAux012 } from "../models/modelAUX012";
import { IModelCrm019 } from "../models/modelCRM019";
import { IModelCrm052 } from "../models/modelCRM052";
import { IModelCrm023 } from "../models/modelCRM023";
import { IModelRelatorioPDF } from "../models/modelRelatorioPDF";
import { EnumSimNao } from "../enums/enums";

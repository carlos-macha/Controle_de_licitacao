.card:has(.quadro-container) {
   background: none !important;
}

.quadro-container {
   /* border-width: 15px;
   border-style: solid;
   border-image: linear-gradient(0deg, rgba(0,111,255,1) 0%, rgba(1,88,204,1) 35%, rgba(0,66,153,1) 100%) 0.5;
   box-shadow: rgba(0, 0, 0, 0.2) 0px 1px 3px 1px; */

   /* background: linear-gradient(0deg, rgba(0,111,255,1) 0%, rgba(1,88,204,1) 35%, rgba(0,66,153,1) 100%); */
   overflow: auto !important;
   color: #393939;
   display: flex;
   flex-direction: row;
   align-items: flex-start;
   width: 100%;
   height: calc(100vh - 15.5rem);
}

.iframe-mode-fullscreen .quadro-container {
   height: calc(100vh - 7.5rem) !important;
}

.quadro-laneDrag {
   height: calc(100% - 130px) !important;
   
   margin-top: 0px;
   margin-bottom: 20px;
   margin-left: 20px;
   margin-right: 20px;
}

.quadro-laneDrag.hidePrice {
   height: calc(100% - 80px) !important;
}

.quadro-laneScrollable {
   overflow-y: auto !important;
   overflow-x: hidden !important;
   height: calc(100% - 5px) !important;
}

.quadro-lane {
   color: black;
   outline-color: black;
   outline-offset: -10px;

   padding-top: 0.1px;

   background: #f3f7fd;
   width: 300px !important;

   /* border-width: 2px;
   border-style: solid; */
   border-radius: 1rem;

   height: calc(100vh - 16rem) !important;

   /* user-select: none; */
}

.dark .quadro-lane {
   color: white;
   outline-color: white;

   background: #25294a;
}

.iframe-mode-fullscreen .quadro-lane {
   height: calc(100vh - 8rem) !important;
}

.quadro-container.dragging .quadro-lane {
   /* outline: 2px dashed #0084ff !important; */
   outline-width: 2px !important;
   outline-style: dashed !important;
}

.quadro-container.dragging .quadro-lane.notPermissions {
   outline-color: #ffffff00;
}

.quadro-container.dragging .quadro-lane.isPermissible {
   outline-color: #00ca00;
}

.quadro-container.dragging .quadro-lane.isPermissible {
   outline-color: #00ca00aa;
}

.quadro-container.dragging .quadro-lane.notPermissible {
   outline-color: #e64141;
}

.quadro-container.dragging .quadro-lane.notPermissible {
   outline-color: #e64141aa;
}

/* */

.quadro-card {
   /* user-select: none; */
   margin: 0 0 8px 0;
   overflow: hidden;
   color: black;

   border-width: 1px;
   border-style: solid;
   border-color: black;
   border-radius: 8px;
}

.dark .quadro-card {
   color: white;
   border-color: white;
}

.quadro-laneHeader {
   margin: 10px;
}

.quadro-laneHeaderTop {
   padding: 10px;

   border-radius: 5px;
   
   height: 70px;
   display: flex;
   justify-content: space-between;

   box-shadow: 0px 1px 1px #091e4240, 0px 0px 1px #091e424f;
}

.dark .quadro-laneHeaderTop {
   color: white;
}

.quadro-laneHeaderBottom {
   padding-left: 5px;
   margin: 10px;
   /* background: white; */

   border-radius: 5px;

   /* box-shadow: 0px 1px 4px #091e4240; */

   white-space: nowrap;
   text-overflow: ellipsis;
   overflow: hidden;
}

/* .dark .quadro-laneHeaderBottom {
   background: rgb(32, 36, 66);
} */

.quadro-laneHeaderTitle {
   font-weight: bold;
   overflow: hidden;
   text-overflow: ellipsis;
   text-wrap: nowrap;

   display: -webkit-box; /* Define o elemento como uma caixa flexível */
  -webkit-line-clamp: 2; /* Limita o número de linhas a 2 */
  -webkit-box-orient: vertical; /* Orientação vertical das linhas */
   white-space: normal;
}

.quadro-laneHeaderCount {
   height: 25px;

   margin-left: 7.5px;
   padding-left: 7.5px;
   padding-right: 7.5px;

   box-shadow: 0px 1px 1px #091e4240, 0px 0px 1px #091e424f;

   background-color: white;

   border-radius: 4px;

   color: black;
}

/* .dark .quadro-laneHeaderCount {
   background-color: #2d325a;
} */



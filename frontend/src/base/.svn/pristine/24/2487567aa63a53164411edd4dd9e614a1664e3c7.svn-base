.quadro-card {
   /* box-shadow: 0 1px 2px rgba(56, 65, 74, 0.15); */
   box-shadow: 0px 1px 2px #091e4240;
   margin-right: 4px !important;
   border-radius: 8px;

   transition: box-shadow 0.3s ease;
   
   /* background-color: #e9edf4 !important;
   border-radius: 8px !important;
   box-shadow: 0px 1px 1px #091e4240, 0px 0px 1px #091e424f;
   color: #172b4d;
   min-height: 36px;
   position: relative;

   margin: 3px; */
}
.quadro-container:has(.isDragging) .quadro-card:hover {
   box-shadow: none;
}

.quadro-card:hover {
   box-shadow: 3.75px 5px 2.5px rgba(34, 33, 81, 0.25);
}

.quadro-card.isDragging {
   box-shadow: -1px 0 15px 0 rgba(34, 33, 81, 0.01), 0px 10px 10px 5px rgba(34, 33, 81, 0.25);
}

.quadro-container:has(.isDragging) .quadro-lane.notPermissible:hover {
   cursor: not-allowed !important;
}


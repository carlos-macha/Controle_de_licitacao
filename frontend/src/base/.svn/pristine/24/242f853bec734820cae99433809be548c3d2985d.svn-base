import React, { Fragment } from 'react';
import Crudpesquisa, { PesquisaProps } from '../../../components/crud/pesquisa/crudpesquisa';
import { IModelCrm009 } from '../../../models/modelCRM009';

interface TiposdeCompromissoPesquisaProps extends PesquisaProps {
   heightGrid?: string | number
}

const TiposdeCompromissoPesquisa: React.FC<TiposdeCompromissoPesquisaProps> = (props) => {
   const { events, onDataChange, heightGrid } = props;

   return (
      <Fragment>
         <Crudpesquisa
            autoLoad
            heightGrid={heightGrid ? heightGrid : 'calc(100vh - 24rem)'}
            events={events}
            typePagination='limit-offset'
            onDataChange={(data: IModelCrm009) => {
               if (onDataChange)
                  onDataChange(data);
            }}
            prefixId='grid-tiposdecompromisso-pesquisa'
         />
      </Fragment>
   );
}

export default TiposdeCompromissoPesquisa;
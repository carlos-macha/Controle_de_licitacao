}

.rbc-date-cell {
   padding: 0px;
}

.rbc-now .dateHeader-text {
   color: white;
   border-radius: 50%;
   background: #0084ff;
}

/**/
.rbc-event:has(.rbc-event-content.yellow) {
   background: linear-gradient(to right, yellow 22px, #bad9f1 20px);
}

.rbc-event:has(.rbc-event-content.isProspect.yellow) {
   background: linear-gradient(to right, yellow 22px, #a0bbce 20px);
}

.dark .rbc-event:has(.rbc-event-content.yellow) {
   background: linear-gradient(to right, rgb(190, 190, 0) 22px, #004299 20px);
}

.dark .rbc-event:has(.rbc-event-content.isProspect.yellow) {
   background: linear-gradient(to right, rgb(190, 190, 0) 22px, #002299 20px);
}

.rbc-event:has(.rbc-event-content.orange) {
   background: linear-gradient(to right, orange 22px, #bad9f1 20px);
}

.rbc-event:has(.rbc-event-content.isProspect.orange) {
   background: linear-gradient(to right, orange 22px, #a0bbce 20px);
}

.dark .rbc-event:has(.rbc-event-content.orange) {
   background: linear-gradient(to right, rgb(190, 125, 0) 22px, #004299 20px);
}

.dark .rbc-event:has(.rbc-event-content.isProspect.orange) {
   background: linear-gradient(to right, rgb(190, 125, 0) 22px, #002299 20px);
}

.rbc-event:has(.rbc-event-content.red) {
   background: linear-gradient(to right, red 22px, #bad9f1 20px);
}

.rbc-event:has(.rbc-event-content.isProspect.red) {
   background: linear-gradient(to right, red 22px, #a0bbce 20px);
}

.dark .rbc-event:has(.rbc-event-content.red) {
   background: linear-gradient(to right, rgb(190, 0, 0) 22px, #004299  20px);
}

.dark .rbc-event:has(.rbc-event-content.isProspect.red) {
   background: linear-gradient(to right, rgb(190, 0, 0) 22px, #002299  20px);
}


.rbc-month-view .rbc-event, .rbc-event-allday {
   width: calc(100% - 4px) !important;
}

.rbc-event.rbc-selected {
   border: 2px solid #777D74 !important;
   padding-top: 0px !important;
   padding-bottom: 0px !important;
   padding-left: 3px !important;
   padding-right: 3px !important;
   z-index: 1;
}

.dark .rbc-event.rbc-selected {
   border: 2px solid rgb(215, 215, 215) !important;
}

/***********/

.fullShowing .rbc-month-view, .fullShowing .rbc-time-view {
   width: 100% !important;
}

.fullShowing .showOptions {
   display: inline !important;
}

.showOptions.inForm {
   display: none !important;
}

.calendarInForm .rbc-month-view {
   width: 100%;
}

.calendarInForm .rbc-time-view {
   width: 100%;
}

.rbc-header div {
   white-space: nowrap;
   overflow: hidden;
   text-overflow: ellipsis;
}

.rbc-off-range-bg {
   background: #eeeeee;
}

.dark .rbc-off-range-bg {
   background: #191b31;
}

.rbc-month-view {
   width: 69%;
}

@media (min-width: 1870px) {
   .rbc-month-view {
      width: calc(100% - 476px);
   }
}

.dark .rbc-month-view, .dark .rbc-time-view {
   border-top: 1px solid #525252;
   border-bottom: 2px solid #525252;
   border-left: 1px solid #525252;
   border-right: 2px solid #525252;
}

.rbc-month-row, .rbc-time-header-content {
   cursor: pointer;
}

.rbc-time-view {
   width: 69%;
}

@media (min-width: 1870px) {
   .rbc-time-view {
      width: calc(100% - 476px);
   }
}

.rbc-navbar {
   border-top: 1px solid #ddd;
   border-left: 1px solid #ddd;
   border-right: 1px solid #ddd;
}

.dark .rbc-navbar {
   border-top: 2px solid #525252;
   border-left: 2px solid #525252;
   border-right: 2px solid #525252;
}

.dark .rbc-timeslot-group {
   border-bottom: 1px solid #525252;
}

.dark .rbc-day-slot .rbc-time-slot {
   border-top: 1px solid #525252;
}

.dark .rbc-time-header-content {
   border-left: 1px solid #525252;
}

.dark .rbc-time-header.rbc-overflowing {
   border-right: 1px solid #525252;
}

.rbc-time-content {
   border-top: 1px solid #ddd;
}

.dark .rbc-time-content {
   border-top: 1px solid #525252;
}

.dark .rbc-time-content > * + * > * {
   border-left: 1px solid #525252;
}

/******************************************************************************* *** DatePicker *** *******************************************************************************/

/*- Botão de Selecionar -*/

.pick-date:hover, .pick-date.selected, .pick-more:hover {
   background: #ddd;
   border-radius: 5px;
}

.dark .pick-date:hover, .dark .pick-date.selected, .dark .pick-more:hover {
   background: #2a2d47;
}

/*- Geral -*/

.react-datepicker-popper {
   z-index: 9999;
   border-radius: 0.3rem;
   box-sizing: border-box;
   box-shadow: rgba(0, 0, 0, 0.133) 0px 6.4px 14.4px 0px, rgba(0, 0, 0, 0.11) 0px 1.2px 3.6px 0px;
}

.react-datepicker__month-text, .react-datepicker__current-month, .react-datepicker__month-read-view--selected-month, .react-datepicker__day-name, .react-datepicker__month-option {
   text-transform: capitalize;
}

.react-datepicker__current-month, .react-datepicker__day-name {
   cursor: default;
}

/*- Mês -*/

.react-datepicker__month-text {
   height: 40px !important;
   width: 72.5px !important;
   padding-top: 5% !important;
}

.react-datepicker__month-text:hover {
   background: #ddd !important;
}

.dark .react-datepicker__month-text:hover {
   background: #2a2d47 !important;
}

.react-datepicker__month-text--today {
   font-weight: normal;
}

.react-datepicker__month-text--selected {
   background: #bad9f1 !important;
   color: black;
   font-weight: bold;
}

.dark .react-datepicker__month-text--selected {
   background: #004299 !important;
}

.react-datepicker__month-text--selected:hover {
   background: #bad9f1 !important;
}

.dark .react-datepicker__month-text--selected:hover {
   background: #004299 !important;
}

.react-datepicker__month-text--keyboard-selected, .react-datepicker__day--keyboard-selected {
   background: white;
}

.dark .react-datepicker__month-text--keyboard-selected, .dark .react-datepicker__day--keyboard-selected {
   background: black;
}

/*- Dia -*/

.react-datepicker__day--selected {
   background: #bad9f1 !important;
   color: black !important;
}

.dark .react-datepicker__day--selected {
   background: #004299 !important;
   color: white !important;
}

.react-datepicker__day:hover {
   background: #ddd !important;
}

.dark .react-datepicker__day:hover {
   background: #2a2d47 !important;
}

.react-datepicker__day--today, .react-datepicker__day--today:hover {
   background: #0084ff !important;
   border-radius: 5px;
   color: white !important;
   font-family: "Helvetica Neue", helvetica, arial, sans-serif;
   font-size: 0.8rem;
}

.dark .react-datepicker__day--today, .dark .react-datepicker__day--today:hover {
   background: #0084ff !important;
   border-radius: 5px;
   color: white !important;
   font-family: "Helvetica Neue", helvetica, arial, sans-serif;
   font-size: 0.8rem;
}

/*- Semana e dia -*/

.react-datepicker__month-container.week-mode .react-datepicker__week:hover {
   background: #ddd !important;
   border-radius: 5px;
}

.dark .react-datepicker__month-container.week-mode .react-datepicker__week:hover {
   background: #2a2d47 !important;
}

.react-datepicker__month-container.week-mode .react-datepicker__week:hover .react-datepicker__day--keyboard-selected {
   background: #ddd !important;
}

.dark .react-datepicker__month-container.week-mode .react-datepicker__week:hover .react-datepicker__day--keyboard-selected {
   background: #2a2d47 !important;
}

.react-datepicker__month-container.week-mode .react-datepicker__week:hover .react-datepicker__day--selected {
   background: #ddd !important;
}

.dark .react-datepicker__month-container.week-mode .react-datepicker__week:hover .react-datepicker__day--selected {
   background: #2a2d47 !important;
}

.react-datepicker__month-container.week-mode .react-datepicker__week:has(.react-datepicker__day--selected) {
   background: #bad9f1;
   border: 1px solid black;
   border-radius: 5px;
   margin: 0px;
}

.dark .react-datepicker__month-container.week-mode .react-datepicker__week:has(.react-datepicker__day--selected) {
   background: #004299;
}

.react-datepicker__month-container.week-mode .react-datepicker__week:has(.react-datepicker__day--selected) .react-datepicker__day--keyboard-selected {
   background: #bad9f1 !important;
}

.dark .react-datepicker__month-container.week-mode .react-datepicker__week:has(.react-datepicker__day--selected) .react-datepicker__day--keyboard-selected {
   background: #004299 !important;
}

.react-datepicker__month-container:not(.week-mode) .react-datepicker__day--selected {
   background: #bad9f1;
   border: 1px solid black;
}

.dark .react-datepicker__month-container:not(.week-mode) .react-datepicker__day--selected {
   background: #004299;
}

/*- Restante do modo dark -*/

.dark .react-datepicker {
   border: 0.125rem solid #525252;
}

.dark .react-datepicker__header, .dark .react-datepicker__year-option {
   background-color: #131425;
   color: white;
}

.dark .react-datepicker__month-text, .dark .react-datepicker__current-month, .dark .react-datepicker__day-name, .dark .react-datepicker__day {
   color: white !important;
}

.dark .react-datepicker__month {
   margin: 0px;
   padding: 0.4rem;
   background: #191b31;
}

/**********************************************************************************************************************************************************************************/
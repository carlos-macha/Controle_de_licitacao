@media (max-width: 1065px) {
   .maxOptionsTab, .optionsTab {
      display: none !important;
   }

   .customToolbar {
      width: 100% !important;
      transition: all 1s;
   }

   .rbc-month-view {
      width: 100% !important;
      transition: all 1s;
   }
   
   .rbc-time-view {
      width: 100% !important;
      transition: all 1s;
   }
}

@media (min-width: 1066px) {
   .showOptions:not(.fullShowing) {
      display: none;
   }
}

.postNavAgenda {
   container: navAgenda / inline-size;
}

@container navAgenda (width < 764px) {
   .more {
      display: flex !important;
   }

   .button-6 {
      display: none !important;
   }
      
   .button-6-drop {
      display: flex !important;
   }

   @container (width < 714px) {

      .button-5 {
         display: none !important;
      }
      
      .button-5-drop {
         display: flex !important;
      }

   } 

   @container (width < 628px) {
      .button-4 {
         display: none !important;
      }
      
      .button-4-drop {
         display: flex !important;
      }
   }

   @container (width < 518px) {
      .button-3 {
         display: none !important;
      }
      
      .button-3-drop {
         display: flex !important;
      }
   }

   @container (width < 332px) {
      .button-2 {
         display: none !important;
      }
      
      .button-2-drop {
         display: flex !important;
      }
   }

   @container (width < 252px) {
      .button-1 {
         display: none !important;
      }
      
      .button-1-drop {
         display: flex !important;
      }
   }
}



.agenda-datatable-view {
   width: 69%;
   padding-right: 27.5px;
}

@media (min-width: 1870px) {
   .agenda-datatable-view {
      width: calc(100% - 476px);
   }
}

.fullShowing .agenda-datatable-view {
   width: 100%;
   padding-right: 40px;
}

.customToolbar {
   width: 69%;
}

@media (min-width: 1870px) {
   .customToolbar {
      width: calc(100% - 476px);
   }
}

.fullShowing .customToolbar {
   width: 100%;
}

.maxOptionsTab {
   position: absolute;
   left: 69%;
   width: calc(31% - 1.2rem);
   height: calc(100% - 2.5rem);
}

@media (min-width: 1870px) {
   .maxOptionsTab {
      width: 468px;
      left: calc(100% - 488px);
   }
}

.optionsTab {
   height: 100%;
   border: 1px solid #ddd;
   border-radius: 5px;
}

.dark .optionsTab {
   border: 2px solid #525252 !important;
}

.dark .rbc-header {
   border: 1px solid #525252 !important;
}

.dark .rbc-month-row {
   border-top: 1px solid #525252;
}

.rbc-today {
   background: none;
}

.day-bg {
   height: 100%;
}

.rbc-time-view .day-bg {
   height: calc(100% - 2px);
}

.rbc-day-bg {
   background: none;
}

.dark .rbc-day-bg {
   border-left: 1px solid #525252;
}

.rbc-day-bg.rbc-selected-day .day-bg {
   background: #eaf6ff;
   border: 1px solid #aaa;
}

.dark .rbc-day-bg.rbc-selected-day .day-bg {
   background: #25294a;
   border: 1px solid #479ef5;
}

.rbc-time-view .rbc-day-bg.rbc-selected-day .day-bg {
   border: 1px solid #aaa;
}

.dark .rbc-time-view .rbc-day-bg.rbc-selected-day .day-bg {
   border: 1px solid #479ef5;
}

.rbc-header {
   cursor: default;
}

.rbc-row-segment {
   margin-top: 2px;
}

.rbc-button-link {
   pointer-events: none;
   cursor: default;
   margin-left: 1px;
   width: calc(100% - 1px) !important;
}

.dark .rbc-button-link.rbc-show-more {
   background: #2d325a;
}

